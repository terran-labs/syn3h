{
  "scripts": {
    "dashboard": {
      "type": "service",
      "command": "node dashboard/server.mjs --port $PASEO_PORT"
    },
    "game": {
      "type": "service",
      "command": "npx vite --host 127.0.0.1 --port $PASEO_PORT --strictPort"
    },
    "terrainlab": {
      "type": "service",
      "command": "SYN3H_NO_ROOM_SERVER=1 npx vite --host 127.0.0.1 --port $PASEO_PORT --strictPort"
    },
    "stable": {
      "type": "service",
      "command": "cd ../Syn3h-stable/current && npx wrangler dev --local --ip 127.0.0.1 --port $PASEO_PORT"
    }
  }
}